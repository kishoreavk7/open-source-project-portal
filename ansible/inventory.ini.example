# =========================================================================
# Ansible Inventory Example - Open Source Project Portal
# Copy this file to 'inventory.ini' and update host IP addresses
# DO NOT store real passwords or private keys in Git!
# =========================================================================

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/id_rsa
ansible_python_interpreter=/usr/bin/python3

# Kubernetes Control Plane (Master Node)
[master]
k8s-master ansible_host=10.0.1.10

# Kubernetes Worker Nodes
[workers]
k8s-worker-1 ansible_host=10.0.10.21
k8s-worker-2 ansible_host=10.0.10.22

# Grouping all nodes together
[k8s_cluster:children]
master
workers
