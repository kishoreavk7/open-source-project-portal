# =========================================================================
# Environment Variables Example - Open Source Project Portal
# Copy to '.env' for local container overrides.
# NEVER commit real passwords or API keys to version control!
# =========================================================================

# Spring Application Coordinates
SPRING_APPLICATION_NAME=open-source-project-portal
SERVER_PORT=8080

# GitHub Integration Coordinates
GITHUB_OWNER=kishoreavk7
GITHUB_REPOSITORY=open-source-project-portal

# Actuator Health Exposure
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always

# Container Registry Configuration
DOCKER_REGISTRY=docker.io
DOCKER_USERNAME=YOUR_DOCKER_USERNAME
DOCKER_IMAGE=open-source-project-portal
DOCKER_TAG=latest

# Jenkins Credentials ID in Jenkins Credential Store
DOCKER_CREDENTIALS_ID=dockerhub-credentials
